#  VALIDATION INPUT FILE.

PROBLEM GENERAL

MESH
    GMSH       water_tank.msh
    SCALE      30.0 30.0 30.0 # Scales the mesh, as the provided file is actually just 1 x 1 x 1 (with scaled-down field size)
END

MATERIALS
    WATER
        DENSITY 1.0 # g / cc
        H   2
        O   1
    END
END

ANGULAR
    PNSCATTERING    11
END

PARTICLES
    PHOTONS
        GRID        0.001:6.0:25
        ANGULAR     SN
        SOLVER      SI
    END
    ELECTRONS
        GRID        LOGARITHMIC
        GROUPS      35
        MIN         0.001
        MAX         6.0
        ANGULAR     SN
        SOLVER      GMRES
    END
END

BEAM
    PARTICLE 1
    MONOCHROMATIC 1
    AXIS    0.0  0.0 -1.0   # Defined in the mesh coordinate system (after any mesh scaling/translating)
    ORIGIN  0.0  0.0  130.0
    CUTOUT  RECTANGLE 100.0 0.0 10.0 10.0
    SPHERICAL
END

POSTPROCESSING
    FLUENCE
    ENERGY
    DOSE
    CHARGE
END

STORAGELIMITED # I'm doing this to avoid a large h5 file. Consider turning this off for your own run
